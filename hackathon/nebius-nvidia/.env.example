# Copy this file to .env beside it. passport-nebius reads .env from the folder you run it in,
# and the repository ignores every .env, so the key never reaches git.

# The key from the Nebius Token Factory console.
NEBIUS_API_KEY=

# The NVIDIA model used when --model is absent, spelled exactly as `passport-nebius models`
# lists it. Leave empty to name one on each command.
NEBIUS_MODEL=

# Token Factory's address, only when it is not https://api.tokenfactory.nebius.com/v1
# NEBIUS_BASE_URL=

# The key of the postman's own model server (doorstep run --onboard), only when that server was
# started with one.
# ONBOARD_API_KEY=
