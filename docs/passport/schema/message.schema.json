{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rokbenko/quackd/blob/main/docs/passport/schema/message.schema.json",
  "title": "Robot Passport v1.0 talk message",
  "description": "One talk message: the payload of a compact JWS whose protected header carries alg Ed25519 (or the older EdDSA), kid equal to from, and typ robot-passport-msg+jws. Every message is signed by its sender's robot key. The normative text is docs/passport/spec.md.",
  "type": "object",
  "required": ["passport", "type", "from", "msg", "body"],
  "properties": {
    "passport": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "type": {
      "description": "hello, say, bye, ask, answer or share. A receiver ignores a message of any other type.",
      "type": "string",
      "maxLength": 16
    },
    "from": { "$ref": "#/$defs/id" },
    "to": {
      "description": "The receiver's id, or * for anyone listening on a shared channel.",
      "type": "string",
      "maxLength": 128
    },
    "msg": { "$ref": "#/$defs/token" },
    "re": { "$ref": "#/$defs/token" },
    "nonces": {
      "description": "The session's two nonces, the initiator's first. Every message after the hello's first carries them.",
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/nonce" }, { "$ref": "#/$defs/nonce" }],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "body": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "hello" } } },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "passport": {
                "description": "The sender's passport, carried in the hello itself: a compact JWS signed by its owner's key. Its id is the hello's from.",
                "type": "string"
              },
              "nonce": { "$ref": "#/$defs/nonce" },
              "software": {
                "description": "What wrote the hello, for a person reading a log. Nobody signs it but the robot.",
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "beacon": {
                "description": "The beacon id the sender's radio advertises now: eight random bytes in lower-case hex, which rotate.",
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "reach": {
                "description": "How to reach the sender: a few short scalars, http_port the port of its talk inbox on the address the hello came from.",
                "type": "object",
                "maxProperties": 4,
                "properties": { "http_port": { "type": "integer", "minimum": 1, "maximum": 65535 } },
                "additionalProperties": {
                  "anyOf": [{ "type": "integer" }, { "type": "boolean" }, { "type": "string", "maxLength": 64 }]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "say" } } },
      "then": {
        "properties": {
          "body": {
            "required": ["text"],
            "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 400 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ask" } } },
      "then": {
        "required": ["nonces"],
        "properties": {
          "body": {
            "required": ["skill"],
            "properties": {
              "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "args": { "type": "object" },
              "why": { "type": "string", "maxLength": 120 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "answer" } } },
      "then": {
        "required": ["re"],
        "properties": {
          "body": {
            "required": ["result"],
            "properties": {
              "result": { "enum": ["ok", "no", "later"] },
              "reason": { "type": "string", "maxLength": 120 },
              "versions": {
                "type": "array",
                "maxItems": 8,
                "items": { "type": "string", "maxLength": 16 }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "share" } } },
      "then": {
        "properties": {
          "body": {
            "required": ["about", "fact"],
            "properties": {
              "about": { "type": "string", "maxLength": 64 },
              "fact": { "type": "string", "maxLength": 200 },
              "place": { "type": "string", "maxLength": 64 },
              "age_s": { "type": "integer", "minimum": 0 },
              "confidence": { "type": "string", "maxLength": 16 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,64}$" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,64}$" }
  }
}
