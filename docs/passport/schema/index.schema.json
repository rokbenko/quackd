{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rokbenko/quackd/blob/main/docs/passport/schema/index.schema.json",
  "title": "Robot Passport v0.1 index",
  "description": "What a host that fronts several robots serves at /.well-known/robot-passport.json instead of one passport. It has robots and no id, which is how a reader tells the two apart. Every url names the same host the index came from. The normative text is docs/passport/spec.md.",
  "type": "object",
  "required": ["passport", "robots"],
  "not": { "required": ["id"] },
  "properties": {
    "passport": { "type": "string", "pattern": "^0\\.(0|[1-9][0-9]*)$" },
    "robots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "name": { "type": "string", "maxLength": 64 },
          "id": {
            "type": "string",
            "anyOf": [
              { "pattern": "^did:key:z6Mk[1-9A-HJ-NP-Za-km-z]{44}$" },
              {
                "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            ]
          },
          "url": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
