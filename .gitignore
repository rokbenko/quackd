# secrets
.env
.env.*
!.env.example

# runs are artifacts, not source (the hero GIF lives in docs/assets on purpose)
runs/

# lerobot-find-cameras saves a frame per camera here, pictures of whatever room it is in
outputs/

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv*/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
# the crash dump Git Bash leaves on Windows
*.stackdump

# upstream assets, never vendored (docs/reference/licenses.md): a copy of a model, a mesh or a
# policy's weights next to the checkout is one `git add -A` from being permanent in a public
# history.
*.onnx
*.pt
*.stl
# A learned policy's weights are the user's download under their own licence
# (docs/guides/policies.md), and `roboglot policy serve` fetches them into the Hugging Face cache,
# never into the checkout.
*.safetensors
