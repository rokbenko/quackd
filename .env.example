# Copy to .env (gitignored). quackd loads it automatically via python-dotenv, from two places:
# the folder you run the command in, and then, walking up from where quackd itself is installed,
# which is why a .env in the root of a `uv venv` (beside pyvenv.cfg) is read wherever you run
# from. Neither file overrides a variable that is already set in your environment, and when both
# name the same variable the first to define it wins, so the file next to the command you typed
# is the one that counts.
# Copy the names below exactly. They are case sensitive on macOS and Linux, where OPENAI_API_Key
# is not OPENAI_API_KEY, and Windows takes either, so a file that works on one laptop can fail on
# the next.
# You only need the key for the vendor you name with `--llm`, which takes the vendor on its
# own (`--llm anthropic`) or the vendor and a model (`--llm anthropic:claude-opus-5`).
# `--llm fake` needs no key at all.

# One per vendor, and nothing after the `=`: python-dotenv reads the rest of the line as the
# value, so a trailing comment here would become the key itself. `quackd list-models` names
# the vendors, and `quackd doctor` says which of these it can see.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
# Cohere, whose own examples export CO_API_KEY instead. quackd reads that if this is empty.
COHERE_API_KEY=
# Qwen, on Alibaba Model Studio.
DASHSCOPE_API_KEY=
# Kimi, on Moonshot.
MOONSHOT_API_KEY=
# GLM, on Z.ai.
ZAI_API_KEY=
# Meta Model API (Muse Spark). Meta's own examples export MODEL_API_KEY, read if this is empty.
META_API_KEY=
# OpenRouter, on openrouter.ai: one key that reaches other vendors' models. No OpenRouter model
# has answered a real quackd request yet (docs/guides/openrouter.md).
OPENROUTER_API_KEY=

# OpenAI only. Some reasoning models refuse function tools on chat/completions; quackd
# reads that 400 and switches the run to the Responses API on its own. Start there instead:
# QUACKD_OPENAI_API=responses
# QUACKD_OPENAI_REASONING_EFFORT=low   # low, medium, high or xhigh, on either API

# Local and open-source models (see docs/guides/local-llms.md). Presets ollama, vllm, llamacpp and
# lmstudio have default addresses; `--llm local` needs QUACKD_BASE_URL or --base-url.
# QUACKD_BASE_URL=http://localhost:8000/v1
# LOCAL_API_KEY=not-needed
# QUACKD_TOOL_CHOICE=auto        # auto (default) | required | none (omit the field)
# QUACKD_VISION=0                # 1 to send camera frames to a local vision model
# A JSON object merged into every request body, for a field the server wants and quackd
# never sends: this one turns Qwen3's thinking off on vLLM. Every provider that speaks
# OpenAI's API reads it, and --extra-body beats it. Single quotes or none, never double
# quotes, which python-dotenv drops without setting anything.
# QUACKD_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# Optional: which LLM pilots the robot, vendor and model in one value, spelled exactly the way
# `--llm` takes it. A bare vendor (`anthropic`) runs that vendor's own default model, and
# `VENDOR:MODEL` names the one you want, so one value says what two used to.
# A cloud vendor takes an id from quackd's catalogue and refuses anything else before it calls
# out, so `quackd list-models` is the list to pick from, and naming one vendor narrows it.
# OpenRouter can also take an id quackd does not carry, checked against OpenRouter's own model
# list when the run starts unless quackd refuses its spelling first. A local vendor takes any id
# its own server serves.
# `--llm` beats this.
# QUACKD_LLM=anthropic:claude-opus-5
# Anthropic only: reasoning effort (low|medium|high|xhigh|max), default medium.
# QUACKD_EFFORT=medium
# Anthropic only: set to 0 to disable server-side refusal fallbacks.
# QUACKD_ANTHROPIC_FALLBACKS=1

# The log: what quackd shows while it runs, which is the prompt, what the model thought, every
# executor decision, every intent sent to the robot, every result. On by default. On a run
# these say what you watch and not what is kept, because the run directory gets its transcript
# either way (docs/concepts/architecture.md). Nothing after the `=` on a line you uncomment:
# python-dotenv would read the trailing comment below as part of the value.
# QUACKD_LOG=1                   # 0 to turn it off, in the CLI and the MCP server alike
# QUACKD_LOG_THINKING=2000       # characters of reasoning the terminal shows per turn; `all`, or 0 for none
# QUACKD_LOG_PROMPT=1            # 0 hides the system prompt; the transcript keeps it either way
# The names these three had until 0.11, with TRACE where LOG is now, are not read any more.
# A run that finds one of them set says so once, on stderr, and ignores it, so a file that
# switched the log off under an old name has it on again until the line is renamed.
# Anthropic only: `omitted` stops the model returning a summary of its reasoning.
# QUACKD_MAX_TOKENS=16000        # the answer budget per turn
# QUACKD_THINKING_DISPLAY=summarized
# Gemini only: 0 stops quackd asking for thought summaries.
# QUACKD_GEMINI_THOUGHTS=1
# What the model costs, in USD per million tokens: the cost counter a run prints and the
# `cost_usd` it writes into its summary and beside every model call. `in` and `out` are
# required, `cache_read` and `cache_write` optional, comma separated. `--price` beats this and
# both beat quackd's own catalogue rate, and on OpenRouter both beat what OpenRouter billed.
# Set it for a rate you negotiated, a model quackd has no published rate for, or a paid server
# behind a local preset. Nothing after the `=` here either: python-dotenv would read the
# trailing comment as part of the rate.
# QUACKD_PRICE=in=3,out=15,cache_read=0.3,cache_write=3.75

# The physics simulator (`--robot microduck:mujoco`, needs quackd[mujoco]). The first run
# fetches upstream's model and policies into ~/.quackd/cache and checks every file's sha256.
# QUACKD_MUJOCO_BODY=puppet      # a kinematic stand-in that downloads nothing
# QUACKD_CACHE_DIR=~/.quackd/cache
# QUACKD_MICRODUCK_ASSETS=       # a microduck_rl checkout of your own, instead of the download
# QUACKD_MUJOCO_SHADOWS=0        # 1 for upstream's shadows: the prettiest render and the slowest

# The LeRobot arm (`--robot lerobot:real`): how far one action may move a joint, in degrees.
# It is re-sent ten times a second, so this is also the top joint speed. Lower it first. The
# arm's simulator reads it too, so a rehearsal's steps are capped as the arm's will be.
# QUACKD_LEROBOT_MAX_STEP_DEG=5
# The pose the arm is driven to before torque is ever released has no variable here: you fold
# the arm by hand and record it with `quackd robot rest-pose <name>`, and it is kept in the
# registry beside that robot's address (docs/concepts/safety.md).

# The arm's simulator (`--robot lerobot:mujoco`, or a name `quackd robot twin` registered, needs
# quackd[lerobot-sim]). The first connect fetches the SO-101's model from SO-ARM100 into the
# cache QUACKD_CACHE_DIR names above and checks every file's sha256. Its bus faults have no
# variable: `quackd preflight --faults` asks for them, one rehearsal at a time.
# QUACKD_LEROBOT_SIM_ASSETS=     # the Simulation/SO101 directory of an SO-ARM100 checkout of your own, instead of the download

# The robots you have named and the flocks you made of them (`quackd robot`,
# `quackd flock`, docs/guides/registry.md). Two files in this directory: robots.json holds each
# robot's address, token, camera or cameras and rest pose, flocks.json the groups.
# `--registry-dir` beats this.
# QUACKD_REGISTRY_DIR=~/.quackd

# The bridge token a robot that wants one is reached with, when `--token` is absent and the
# robot is not one you registered. Each robot's own installer or daemon writes it on the robot.
# QUACKD_DUCK_TOKEN=            # the Open Duck Mini v2 (bridge/open_duck/install.sh writes it)
# QUACKD_TODDLERBOT_TOKEN=      # the ToddlerBot (its daemon has no installer, so you choose it)

# A board quackd uses and never runs on, such as a Jetson (`--host`, docs/guides/jetson.md): the
# camera, detector and health that bridge/jetson/quackd_jetson_hostd.py serves there, and a
# local preset's model server on the same machine at the preset's own port. `--host` and the
# host a registered robot keeps beat it, and so do QUACKD_BASE_URL and OPENAI_BASE_URL for the
# model. A run whose daemon does not answer is refused. A flock ignores it except for the model.
# QUACKD_HOST=                  # jetson.local, or jetson.local:PORT for a daemon not on 9874
# QUACKD_HOST_TOKEN=            # the daemon's token. `--host-token` and a robot's own beat it

# The LeRobot arm's policy server (`quackd policy serve`, docs/adapters/lerobot/README.md), a
# process of its own whose answers move the arm, which `--policy-url` names on `run`,
# `preflight` and `serve-mcp`. The client reads `--policy-token`, then this, then the ~/.quackd/policy.token
# the server writes when it is given no `--token-file`. There is no variable for the server's
# address, on purpose: one line here would otherwise put a policy in charge of every run.
# QUACKD_POLICY_TOKEN=          # the policy server's token

# Decision LLMs, the optional discrete stepper in front of the model (`quackd run --decision-llm`,
# docs/guides/decision-llms/README.md). Nothing here is read unless a run names one: there is no
# default decision LLM, and a key sitting in this file never switches one on by itself.
# A hosted or server preset needs quackd[decision]; the in-process one needs quackd[laya].
# Jev's key, and Jev's alone: it is TypeSafe's hosted service. A decision LLM you run on your
# own machine wants no key at all, and quackd sends it this one under no circumstances.
TYPESAFE_API_KEY=
# Which decision LLM answers, spelled NAME or NAME:MODEL (`quackd doctor` prints the names it
# knows). `--decision-llm` beats this.
# QUACKD_DECISION_LLM=jev:jev-1.13.0
# Where that decision LLM listens. Needed by `--decision-llm local`, which is any other server
# speaking the same protocol and has no address of its own, and useful for moving a preset off
# the default port it was started on. `--decision-url` beats this.
# QUACKD_DECISION_URL=
# off | shadow | on; --decision-mode beats this; the default is on once a decision LLM is
# named. `shadow` asks every turn and lets nothing it says stand, which is how you watch one
# on your own robot before you trust it.
# QUACKD_DECISION_MODE=on
# What a stepper question costs: quackd's own variable rather than one the SDK reads, and the
# same syntax as QUACKD_PRICE above. The default is whatever rate the named preset carries.
# Jev has a published one ($0.042 per million input tokens, output not charged); a server you
# run yourself has none at all and is costed the way every other model on your own machine is,
# so this line is for a rate quackd does not know. Nothing after the `=` here either, for the
# same reason.
# QUACKD_DECISION_PRICE=in=0.042,out=0
# Anything else spelled TYPESAFE_* belongs to that SDK rather than to quackd, and the one
# exception is TYPESAFE_DEFAULT_MODEL, which quackd honours for `jev` alone when the spec names
# no model. Say it in the spec instead (`--decision-llm jev:jev-latest`): that is the form every
# other decision LLM takes, and the address is `--decision-url` for all of them.

# What each robot remembers between runs (`quackd memory`, docs/guides/memory.md).
# QUACKD_MEMORY_DIR=~/.quackd/memory
