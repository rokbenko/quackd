[Unit]
Description=quackd bridge for the Open Duck Mini v2 (this process IS the 50 Hz walk loop)
Documentation=https://github.com/rokbenko/quackd/blob/main/docs/adapters/open_duck.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/ttyACM0
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=pi
SupplementaryGroups=dialout i2c audio video
# The bridge reads /etc/quackd/duck-bridge.token as this user and REFUSES TO START if
# it exists but cannot be read, rather than running with authentication silently off.
# install.sh group-owns it to this user and verifies that; if you installed by hand,
# make sure this user can read it (or use LoadCredential= and --token-file=%d/...).
# scripts/, not the repository root. Upstream's walk script opens
# "./polynomial_coefficients.pkl" and "../mini_bdx_runtime/assets/" relative to the working
# directory, and both only resolve from here. The bridge chdir's here itself as well, so a
# hand-edited unit that disagrees still works.
WorkingDirectory=/home/pi/Open_Duck_Mini_Runtime/scripts
Environment=PYTHONUNBUFFERED=1
Environment=SDL_VIDEODRIVER=dummy
# The interpreter MUST be the virtualenv you installed Open_Duck_Mini_Runtime into:
# the bridge imports mini_bdx_runtime, and the system python does not have it.
#
# --script-arg uses the = form on purpose. Written as `--script-arg --onnx_model_path`,
# argparse refuses a value beginning with a dash and the unit exits 2 before the bridge
# ever binds a socket.
ExecStart=/home/pi/.virtualenvs/open-duck-mini-runtime/bin/python \
    /opt/quackd/quackd_duck_bridge.py serve \
    --script /home/pi/Open_Duck_Mini_Runtime/scripts/v2_rl_walk_mujoco.py \
    --script-arg=--onnx_model_path --script-arg=/home/pi/BEST_WALK_ONNX_2.onnx \
    --bind 127.0.0.1 --deadman-ms 300
Nice=-5
OOMScoreAdjust=-500
KillSignal=SIGTERM
TimeoutStopSec=8

# Restart is off on purpose. This process crashing means the serial bus failed or the duck
# went down, and restarting a walk policy on a duck lying on its side strips printed gears.
# A human should look. Turn it on only once you have watched this service behave.
Restart=no

[Install]
WantedBy=multi-user.target
