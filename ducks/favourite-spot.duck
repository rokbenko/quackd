# keeps a map: its simulator given a room, as in
# `quackd run favourite-spot --room two-rooms --yes`.
---
duck: 1
name: favourite-spot
description: Mark where you stand as your favourite spot, explore the room, then walk back to the spot and say so.
author: rok
requires: [mark_place, explore, go_to_place, say]
verbs:
  allow: [mark_place, explore, go_to_place, say, map, report_state, stop]
  confirm: []
budgets:
  max_steps: 12
  max_minutes: 6
  max_llm_calls: 12
